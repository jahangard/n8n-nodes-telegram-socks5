{
  "name": "n8n-nodes-telegram-socks5",
  "version": "1.0.0",
  "description": "n8n community node: Telegram (Enhanced) with native SOCKS5 / HTTP proxy support",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "telegram",
    "socks5",
    "proxy"
  ],
  "license": "MIT",
  "homepage": "https://github.com/your-org/n8n-nodes-telegram-socks5",
  "author": {
    "name": "Mehdi Jahangard",
    "email": "mehdi.jahangard@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mehdi-jahangard/n8n-nodes-telegram-socks5.git"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc && gulp build:icons",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials --write",
    "lint": "eslint nodes credentials package.json",
    "lintfix": "eslint nodes credentials package.json --fix",
    "prepublishOnly": "npm run build && npm run lint"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/TelegramSocks5Api.credentials.js"
    ],
    "nodes": [
      "dist/nodes/TelegramSocks5/TelegramSocks5.node.js"
    ]
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^7.15.0",
    "eslint": "^8.57.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.1",
    "gulp": "^4.0.2",
    "n8n-workflow": "^1.63.0",
    "prettier": "^3.3.2",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "form-data": "^4.0.0",
    "https-proxy-agent": "^7.0.4",
    "socks-proxy-agent": "^8.0.4"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
